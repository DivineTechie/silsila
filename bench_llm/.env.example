# Copy to .env and fill in. Never commit .env.
FIREWORKS_API_KEY=
HF_TOKEN=
# Bearer key you choose for the vLLM servers on Modal (sent to Modal as a secret at deploy time)
SILSILA_VLLM_API_KEY=
# Either the URL printed by `modal deploy` per model ...
# MODAL_URL_JAIS_3_7B=https://<workspace>--silsila-vllm-jais-3-7b-serve.modal.run
# ... or your Modal workspace name, from which the URLs are derived
MODAL_WORKSPACE=
# Optional
NCBI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
